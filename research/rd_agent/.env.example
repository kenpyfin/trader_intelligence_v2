# RD-Agent research service configuration
# Copy to .env and fill values. See:
# https://rdagent.readthedocs.io/en/latest/installation_and_configuration.html

# --- LLM (DeepSeek chat + Gemini embedding via LiteLLM) ---
CHAT_MODEL=deepseek/deepseek-chat
DEEPSEEK_API_KEY=

# Embedding model (DeepSeek has no embeddings; use Gemini or SiliconFlow proxy)
EMBEDDING_MODEL=gemini/text-embedding-004
GEMINI_API_KEY=

# Alternative embedding via SiliconFlow:
# EMBEDDING_MODEL=litellm_proxy/BAAI/bge-m3
# LITELLM_PROXY_API_KEY=
# LITELLM_PROXY_API_BASE=https://api.siliconflow.cn/v1

# --- Execution environment ---
MODEL_COSTEER_ENV_TYPE=docker
DS_CODER_COSTEER_ENV_TYPE=docker

# --- Retry / logging ---
MAX_RETRY=10
RETRY_WAIT_SECONDS=20

# --- Optional: shorter demo segments (CSI bundled data) ---
# QLIB_FACTOR_TRAIN_START=2008-01-01
# QLIB_FACTOR_TRAIN_END=2014-12-31
